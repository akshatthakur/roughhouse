{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "microphone=(self)" }] }
  ]
}
